# Copy this file to ".env" and paste in the web app address of the Google Apps
# Script attached to the counts Sheet (Deploy -> Manage deployments -> Web app
# URL). It ends in "/exec".
#
# Leave it out and the app runs in demo mode: everything saved on this device
# only, with a dark banner along the bottom saying so.

VITE_SHEET_URL=https://script.google.com/macros/s/your-deployment-id/exec
